# Copy to .env.local and fill in. .env.local is gitignored.

# Public — inlined into the client bundle at build time. Never put secrets here.
# Used for canonical URLs, sitemap.ts, robots.ts and Open Graph metadata.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret — server-only, read inside the contact Server Action.
# Not yet wired up. The action will fail loudly if this is absent rather
# than silently pretending a message was sent.
# RESEND_API_KEY=""
# CONTACT_TO_EMAIL=""
